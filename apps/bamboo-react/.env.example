# -------- Frontend metadata --------
VITE_APP_NAME=Bamboo ERP (React)
VITE_APP_ENV=development

# -------- API endpoints --------
# Leave empty to use the current origin together with the Vite proxy.
VITE_API_BASE_URL=
# Auth server (ABP Identity). Leave empty to use the same host as API/proxy.
VITE_AUTH_BASE_URL=

# -------- Dev server --------
VITE_DEV_SERVER_PORT=5173
# Enable file polling when running inside Docker/VMs.
VITE_USE_POLLING=false

# -------- Vite proxy targets (dev only) --------
VITE_API_PROXY_TARGET=http://localhost:7105
VITE_AUTH_PROXY_TARGET=http://localhost:7103
