VITE_APP_NAME=Bamboo ERP (React)
VITE_APP_ENV=development

# Keep API/AUTH base empty to rely on Vite proxy inside Docker
VITE_API_BASE_URL=
VITE_AUTH_BASE_URL=

VITE_DEV_SERVER_PORT=5173
VITE_USE_POLLING=true

# Targets use Docker service names
VITE_API_PROXY_TARGET=http://app-core:8080
VITE_AUTH_PROXY_TARGET=http://auth-server:8080
